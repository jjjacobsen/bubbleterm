#!/bin/sh
exec /usr/bin/osascript -l JavaScript - "${0##*/}" "$@" <<'JXA'
ObjC.import('Cocoa');
ObjC.bindFunction('AXIsProcessTrusted', ['bool', []]);
ObjC.bindFunction('AXUIElementCreateApplication', ['id', ['int']]);
ObjC.bindFunction('AXUIElementCopyAttributeValue', ['int', ['id', 'id', 'id*']]);
ObjC.bindFunction('AXUIElementCopyActionNames', ['int', ['id', 'id*']]);
ObjC.bindFunction('AXUIElementPerformAction', ['int', ['id', 'id']]);
ObjC.bindFunction('AXUIElementSetMessagingTimeout', ['int', ['id', 'float']]);
ObjC.bindFunction('CFEqual', ['bool', ['id', 'id']]);

const shell = Application.currentApplication();
shell.includeStandardAdditions = true;
const bundle = 'com.apple.MobileSMS';
const transcriptID = 'TranscriptCollectionView';
const tapbacks = [
    ['love', 'heart'], ['like', 'thumbs_up'], ['dislike', 'thumbs_down'],
    ['laugh', 'ha_ha!'], ['emphasis', 'exclamation_mark'], ['question', 'question_mark'],
];

const sqlQuote = value => "'" + value.replace(/'/g, "''") + "'";
const shellQuote = value => "'" + value.replace(/'/g, "'\\''") + "'";

function query(sql) {
    const path = ObjC.unwrap($.NSHomeDirectory()) + '/Library/Messages/chat.db';
    try {
        const output = shell.doShellScript('/usr/bin/sqlite3 -batch -bail -readonly -init /dev/null -json ' +
            shellQuote(path) + ' ' + shellQuote(sql), { alteringLineEndings: false });
        return output ? JSON.parse(output) : [];
    } catch (error) {
        throw new Error('Cannot read the Messages database');
    }
}

function messageText(row) {
    if (row.text !== null) return row.text;
    const body = row.body;
    // Read the length-prefixed UTF-8 NSString in a typedstream attributed body.
    const marker = /^040B73747265616D7479706564(?:[0-9A-F]{2}){0,100}?8484084E53537472696E67019[45]84012B/.exec(body);
    if (!marker) throw new Error('Unsupported Messages body format');
    let start = marker[0].length;
    let length = parseInt(body.slice(start, start + 2), 16);
    start += 2;
    if (length === 0x81 || length === 0x82) {
        const bytes = length === 0x81 ? 2 : 4;
        length = 0;
        for (let i = 0; i < bytes; i++, start += 2) {
            length += parseInt(body.slice(start, start + 2), 16) * 256 ** i;
        }
    } else if (length > 0x7f) throw new Error('Unsupported Messages body length');
    const end = start + 2 * length;
    if (body.slice(end, end + 2) !== '86') throw new Error('Invalid Messages body length');
    return decodeURIComponent(body.slice(start, end).replace(/../g, '%$&'));
}

function mediaKind(mime) {
    if (/^image\/(?!svg)/i.test(mime)) return 'picture';
    if (/^video\//i.test(mime)) return 'video';
    return null;
}

function clock(seconds) {
    const date = $.NSDate.dateWithTimeIntervalSince1970(seconds);
    return ObjC.unwrap($.NSDateFormatter.localizedStringFromDateDateStyleTimeStyle(date, 0, 1));
}

function resolveMedia(chat, guid, target, kind) {
    if (target.service !== 'iMessage' || !target.seconds) throw new Error('No usable media timestamp or sender direction');
    const minute = clock(target.seconds);
    // AX exposes only a clock time, not the date, file name, or GUID. Search all dates in the chat.
    const competitors = query(`
        SELECT DISTINCT m.date / 1000000000 + 978307200 AS seconds, a.mime_type AS mime
        FROM chat_message_join j JOIN message m ON m.ROWID = j.message_id
        JOIN message_attachment_join ma ON ma.message_id = m.ROWID
        JOIN attachment a ON a.ROWID = ma.attachment_id
        WHERE j.chat_id = ${chat} AND m.guid COLLATE BINARY <> ${guid}
          AND (m.is_from_me = ${target.outgoing} OR m.is_from_me IS NULL OR m.service IS NOT 'iMessage')
          AND NOT (m.is_audio_message IS 1 AND (a.mime_type IS NULL OR a.mime_type LIKE 'audio/%'))
          AND strftime('%M', m.date / 1000000000 + 978307200, 'unixepoch', 'localtime') =
              strftime('%M', ${target.seconds}, 'unixepoch', 'localtime')`);
    if (competitors.some(row => (!mediaKind(row.mime) || mediaKind(row.mime) === kind) && clock(row.seconds) === minute)) {
        throw new Error('Media type and clock time do not identify a unique balloon in this chat');
    }
    return { ...target, kind, minute, part: 0 };
}

function resolveTarget(chat, guid, filename) {
    const rows = query(`
        SELECT c.guid AS chatGUID, c.chat_identifier AS identifier, c.service_name AS chatService,
               m.is_from_me AS outgoing, m.service, m.thread_originator_guid AS origin,
               m.date / 1000000000 + 978307200 AS seconds, m.part_count AS parts,
               m.text, hex(m.attributedBody) AS body
        FROM chat c
        JOIN chat_message_join j ON j.chat_id = c.ROWID
        JOIN message m ON m.ROWID = j.message_id
        WHERE c.ROWID = ${chat} AND m.guid COLLATE BINARY = ${guid}
          AND c.chat_identifier <> ''
          AND (SELECT count(*) FROM chat WHERE chat_identifier COLLATE BINARY = c.chat_identifier) = 1
          AND (SELECT count(*) FROM chat_message_join WHERE message_id = m.ROWID) = 1
          AND COALESCE(m.associated_message_type, 0) = 0 AND COALESCE(m.is_system_message, 0) = 0
          AND COALESCE(m.date_edited, 0) = 0 AND COALESCE(m.date_retracted, 0) = 0
          AND COALESCE(m.item_type, 0) = 0 AND m.balloon_bundle_id IS NULL`);
    if (rows.length !== 1) throw new Error('No unambiguous target in that chat');
    const target = rows[0];
    if (target.identifier.includes('\x00') || ![0, 1].includes(target.outgoing)) {
        throw new Error('The target has no usable chat identifier or sender direction');
    }
    const files = query(`
        SELECT a.filename, a.mime_type AS mime, a.is_sticker AS sticker, a.hide_attachment AS hidden
        FROM message m JOIN message_attachment_join ma ON ma.message_id = m.ROWID
        JOIN attachment a ON a.ROWID = ma.attachment_id WHERE m.guid COLLATE BINARY = ${guid}
          AND NOT (coalesce(a.filename, '') = '' AND a.preflight_info IS NOT NULL AND EXISTS (
              SELECT 1 FROM message_attachment_join other JOIN attachment downloaded ON downloaded.ROWID = other.attachment_id
              WHERE other.message_id = m.ROWID AND downloaded.filename <> ''
                AND downloaded.transfer_name = a.transfer_name AND downloaded.mime_type = a.mime_type))`);
    let text, part = 0;
    if (filename !== undefined || files.length) {
        const [file] = files;
        if (files.length !== 1 || file.hidden || file.sticker || !mediaKind(file.mime) ||
            (filename !== undefined && file.filename !== filename)) {
            throw new Error('Cannot isolate the selected photo or video part');
        }
        const body = messageText({ ...target, text: null });
        // Only handle a standalone attachment or a leading attachment followed by one caption.
        const caption = body.slice(1);
        if (!body.startsWith('\ufffc') || caption.includes('\ufffc') || target.parts !== (caption ? 2 : 1)) {
            throw new Error('Cannot identify the attachment and caption parts');
        }
        if (filename !== undefined || !caption) return resolveMedia(chat, guid, target, mediaKind(file.mime));
        text = caption;
        part = 1;
    } else {
        text = messageText(target);
    }
    if (!text || !text.trim() || /[\x00\ufffc\ufffd]/.test(text)) throw new Error('The target has no usable text');

    // The selected chat is verified separately. Only matching messages in that chat can collide.
    const needle = sqlQuote(text);
    const duplicates = query(`
        SELECT m.is_from_me AS outgoing, m.text, hex(m.attributedBody) AS body
        FROM chat_message_join j JOIN message m ON m.ROWID = j.message_id
        WHERE j.chat_id = ${chat} AND m.guid COLLATE BINARY <> ${guid}
          AND COALESCE(m.associated_message_type, 0) = 0
          AND (m.text COLLATE BINARY = ${needle}
               OR (instr(m.attributedBody, CAST(${needle} AS BLOB)) > 0
                   AND (m.text IS NULL OR instr(m.attributedBody, x'EFBFBC') > 0)))`)
        .filter(row => row.text === text || messageText({ ...row, text: null }).split('\ufffc').includes(text));
    if (duplicates.some(row => row.outgoing === target.outgoing)) {
        throw new Error('Target text is not unique for that sender direction in this chat');
    }
    return { ...target, text, part, ambiguousDirection: duplicates.length > 0 };
}

function attr(element, name) {
    const result = Ref();
    const status = $.AXUIElementCopyAttributeValue(element, name, result);
    if (status === 0) return result[0];
    if (status === -25205 || status === -25212 || status === -25208) return null;
    throw new Error('Cannot read ' + name + ' (AX error ' + status + ')');
}

function value(element, name) {
    const result = attr(element, name);
    return result === null ? null : ObjC.unwrap(result);
}
const children = element => value(element, 'AXChildren') || [];
const role = element => value(element, 'AXRole');
const identifier = element => value(element, 'AXIdentifier');

function hasAction(element, name) {
    const result = Ref();
    return $.AXUIElementCopyActionNames(element, result) === 0 && ObjC.deepUnwrap(result[0]).includes(name);
}

function find(root, matches, prune = () => false) {
    if (matches(root)) return [root];
    if (prune(root)) return [];
    return children(root).flatMap(child => find(child, matches, prune));
}

function waitFor(probe, seconds) {
    const deadline = Date.now() + seconds * 1000;
    do {
        const result = probe();
        if (result) return result;
        delay(0.2);
    } while (Date.now() < deadline);
    return null;
}

function withMenuItem(app, window, parent, requireTarget, itemID, useItem) {
    const isMenu = el => role(el) === 'AXMenu';
    const menus = () => {
        const roots = [window, parent, ...children(app).filter(isMenu)];
        let focused = attr(app, 'AXFocusedUIElement');
        while (focused && !$.CFEqual(focused, app) && !$.CFEqual(focused, window)) {
            if (isMenu(focused)) {
                roots.push(focused);
                break;
            }
            focused = attr(focused, 'AXParent');
        }
        const result = [];
        for (const root of roots) {
            for (const menu of find(root, isMenu, el => [transcriptID, 'ConversationList'].includes(identifier(el)))) {
                if (!result.some(other => $.CFEqual(other, menu))) result.push(menu);
            }
        }
        return result;
    };
    if (menus().length) throw new Error('Close the open Messages menu first');
    requireTarget();
    let menu;
    try {
        const status = $.AXUIElementPerformAction(parent, 'AXShowMenu');
        // Showing a modal menu can time out while the menu is still open.
        if (status !== 0 && status !== -25204) throw new Error('Cannot open the target menu (AX error ' + status + ')');
        const item = waitFor(() => {
            const opened = menus();
            if (opened.length > 1) throw new Error('More than one menu opened');
            if (!opened.length) return null;
            menu = opened[0];
            const matches = find(menu, el => role(el) === 'AXMenuItem' && identifier(el) === itemID);
            if (matches.length > 1) throw new Error('More than one menu item matches the requested action');
            return matches[0];
        }, 2);
        if (!item || !value(item, 'AXEnabled') || !hasAction(item, 'AXPress')) {
            throw new Error('The requested Messages menu item is not available');
        }
        requireTarget();
        return useItem(item);
    } finally {
        const open = () => menus().find(el => !menu || $.CFEqual(el, menu));
        const opened = open();
        if (opened) {
            $.AXUIElementPerformAction(opened, 'AXCancel');
            if (!waitFor(() => !open(), 2)) throw new Error('Cannot close the Messages menu');
        }
    }
}

function horizontalBounds(element) {
    const frame = attr(element, 'AXFrame');
    const match = frame && /value = x:(-?[\d.]+) y:-?[\d.]+ w:([\d.]+) h:/.exec(ObjC.unwrap(frame.description));
    if (!match) throw new Error('Cannot read the Messages balloon position');
    return [Number(match[1]), Number(match[1]) + Number(match[2])];
}

function targetBalloons(view, target) {
    const visible = value(view, 'AXVisibleChildren') || children(view);
    if (target.kind) {
        return visible.flatMap(row => {
            const description = value(row, 'AXDescription');
            if (!description || !description.endsWith(', ' + target.minute)) return [];
            const [sender, label] = description.split(', ');
            if (label !== 'Includes ' + target.kind || !sender ||
                (target.outgoing ? sender !== 'Your iMessage' : sender.startsWith('Your '))) return [];
            const buttons = children(row).filter(el => role(el) === 'AXButton' && identifier(el) === 'Sticker');
            if (buttons.length !== 1 || value(buttons[0], 'AXDescription') !== description) {
                throw new Error('Cannot isolate the media button in the matching row');
            }
            return buttons;
        });
    }
    return visible.flatMap(child => find(child, el => identifier(el) === 'CKBalloonTextView' &&
        value(el, 'AXValue') === target.text)).filter(balloon => {
        if (!target.ambiguousDirection) return true;
        // Self chats can display a sent and a received copy of the same text.
        const [left, right] = horizontalBounds(view);
        const [start, end] = horizontalBounds(balloon);
        const middle = (left + right) / 2;
        if (start > middle) return target.outgoing === 1;
        if (end < middle) return target.outgoing === 0;
        throw new Error('Cannot distinguish the sender direction of a matching balloon');
    });
}

function withTargetMenu(target, itemID, mode, useItem, prepare) {
    if (!$.AXIsProcessTrusted()) throw new Error('Grant Accessibility access to the process that runs this helper');
    // Messages uses different prefixes for regular and pinned sidebar rows.
    const selected = () => {
        const row = shell.doShellScript('/usr/bin/defaults read ' + bundle +
            ' CKLastSelectedItemIdentifier 2>/dev/null || true');
        return row === 'list-' + target.chatGUID || row === 'pinned-' + target.chatGUID;
    };
    // Opening a chat can mark messages as read.
    if (mode && !selected()) throw new Error('Select the target chat in Messages before running ' + mode);
    if (!mode) {
        const url = 'sms://open?groupid=' + encodeURIComponent(target.identifier);
        shell.doShellScript('/usr/bin/open -b ' + bundle + ' ' + shellQuote(url) + ' 2>/dev/null');
    }

    const running = waitFor(() => {
        const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(bundle);
        return Number(apps.count) === 1 && apps.firstObject.isActive && apps.firstObject;
    }, 5);
    if (!running) throw new Error('Messages is not in front');
    const app = $.AXUIElementCreateApplication(running.processIdentifier);
    const timeoutStatus = $.AXUIElementSetMessagingTimeout(app, 1);
    if (timeoutStatus !== 0) throw new Error('Cannot set the Messages AX timeout (AX error ' + timeoutStatus + ')');
    const focusedWindow = () => {
        if (!running.isActive) throw new Error('Messages lost focus');
        if (!selected()) return null;
        const windows = (value(app, 'AXWindows') || []).filter(el => value(el, 'AXSubrole') === 'AXStandardWindow');
        const window = attr(app, 'AXFocusedWindow');
        return windows.length === 1 && window && $.CFEqual(window, windows[0]) ? window : null;
    };
    const transcript = () => {
        const window = focusedWindow();
        if (!window) return null;
        const matches = find(window, el => identifier(el) === transcriptID);
        if (matches.length > 1) throw new Error('More than one Messages transcript is open');
        return matches.length ? { window, view: matches[0] } : null;
    };

    let current = waitFor(transcript, 3);
    if (!current) throw new Error('Cannot verify the selected Messages transcript');
    const context = { app, window: current.window, pid: running.processIdentifier, focusedWindow };
    if (prepare) {
        prepare(context);
        current = transcript();
        if (!current || !$.CFEqual(current.window, context.window)) throw new Error('Messages switched chats or windows');
    }
    for (let page = 0; page <= 3; page++) {
        const matches = targetBalloons(current.view, target);
        if (matches.length > 1) throw new Error('More than one balloon matches the target');
        if (matches.length === 1) {
            const balloon = matches[0];
            const owner = target.kind ? balloon : attr(balloon, 'AXParent');
            const window = focusedWindow();
            if (!window || !$.CFEqual(window, current.window) || !owner || !hasAction(owner, 'AXShowMenu')) {
                throw new Error('Cannot open the exact target balloon menu');
            }
            if (mode === '--dry-run') return 'Tapback target found. No menu opened or reaction sent.';
            return withMenuItem(app, window, owner, () => {
                const focused = focusedWindow();
                if (!focused || !$.CFEqual(focused, window)) throw new Error('Messages switched chats or windows');
                const found = targetBalloons(current.view, target);
                if (found.length !== 1 || !$.CFEqual(found[0], balloon)) throw new Error('The target balloon changed');
            }, itemID, item => useItem(item, context));
        }
        if (mode === '--dry-run') throw new Error('Target balloon is not visible in the selected chat');
        if (page === 3) break;
        const scroll = 'AXScrollUpByPage';
        let el = current.view;
        while (el && !$.CFEqual(el, current.window) && !hasAction(el, scroll)) el = attr(el, 'AXParent');
        if (!el || $.CFEqual(el, current.window) || $.AXUIElementPerformAction(el, scroll) !== 0) break;
        delay(0.35);
        current = transcript();
        if (!current) break;
    }
    throw new Error('Target balloon not found within three scroll pages');
}

function react(args) {
    const mode = ['--check', '--dry-run'].includes(args[0]) ? args.shift() : null;
    const [chat, guid, kind, option, filename] = args;
    const reaction = tapbacks.findIndex(entry => entry[0] === kind);
    if ((args.length !== 3 && !(args.length === 5 && option === '--attachment' && filename)) ||
        !/^[1-9][0-9]{0,18}$/.test(chat) || (chat.length === 19 && chat > '9223372036854775807') || !guid || reaction < 0) {
        throw new Error('Usage: bubbleterm-react [--check|--dry-run] CHAT_ID MESSAGE_GUID love|like|dislike|laugh|emphasis|question [--attachment FILENAME]');
    }
    const target = resolveTarget(chat, sqlQuote(guid), filename);
    const itemID = tapbacks[reaction][1];
    if (mode) return withTargetMenu(target, itemID, mode, () => 'Tapback target verified. No reaction sent.');
    const type = 2000 + reaction;
    const lowerGUID = guid.toLowerCase();
    const partGUID = 'p:' + target.part + '/' + lowerGUID;
    // Synced reactions may be linked to a different chat but still address this exact GUID.
    const events = (after = 0) => query(`
        SELECT guid, lower(associated_message_guid) AS target, associated_message_type AS type
        FROM message
        WHERE is_from_me = 1 AND COALESCE(error, 0) = 0 AND ROWID > ${after}
          AND (associated_message_type BETWEEN 2000 AND 2006 OR associated_message_type BETWEEN 3000 AND 3006)
          AND (lower(associated_message_guid) IN (${sqlQuote(lowerGUID)}, ${sqlQuote('bp:' + lowerGUID)})
               OR (substr(lower(associated_message_guid), 1, 2) = 'p:'
                   AND lower(substr(associated_message_guid, instr(associated_message_guid, '/') + 1)) = ${sqlQuote(lowerGUID)}))
        ORDER BY date, ROWID`).filter(row => row.target === lowerGUID || row.target.replace(/^(?:p:[0-9]+\/|bp:)/, '') === lowerGUID);
    const onPart = row => row.target === partGUID || (target.part === 0 && (
        (row.target === lowerGUID && (!target.kind || target.parts === 1)) ||
        (row.target === 'bp:' + lowerGUID && !target.kind)
    ));
    const prior = events();
    if (prior.some(row => !row.target.startsWith('p:') && !onPart(row))) {
        throw new Error('An existing tapback does not identify a part');
    }
    let active = null;
    for (const row of prior.filter(onPart)) {
        if (row.type < 3000) active = row;
        else if (active && row.type === active.type + 1000) active = null;
    }
    if (active && active.type === type) return active.guid;

    const after = query('SELECT CAST(COALESCE(max(ROWID), 0) AS TEXT) AS id FROM message')[0].id;
    return withTargetMenu(target, itemID, null, item => {
        // Never press again: even a failed AX call can have applied the tapback.
        try {
            const status = $.AXUIElementPerformAction(item, 'AXPress');
            const recorded = waitFor(() => {
                const added = events(after).filter(row => row.type < 3000);
                if (added.length > 1) throw new Error('More than one tapback was added to the target');
                if (added.length && !onPart(added[0])) throw new Error('A tapback was recorded on a different part');
                return added.length && added[0].type === type && added[0].guid;
            }, 5);
            if (recorded) return recorded;
            throw new Error('No matching outgoing tapback was recorded (AX result ' + status + ')');
        } catch (error) {
            throw new Error(error.message + '. Check Messages before retrying');
        }
    });
}

function composer(context, description, placeholder) {
    const window = context.focusedWindow();
    if (!window || !$.CFEqual(window, context.window)) return null;
    const views = find(window, el => identifier(el) === transcriptID);
    if (views.length !== 1 || value(views[0], 'AXDescription') !== description) return null;
    const entries = find(window, el => identifier(el) === 'MessageEntryView',
        el => [transcriptID, 'ConversationList'].includes(identifier(el)));
    if (entries.length !== 1) return null;
    const fields = children(entries[0]).filter(el => identifier(el) === 'messageBodyField' && role(el) === 'AXTextField');
    if (fields.length !== 1 || value(fields[0], 'AXPlaceholderValue') !== placeholder || !value(fields[0], 'AXEnabled')) return null;
    return { view: views[0], field: fields[0], entry: entries[0] };
}

function emptyComposer(current) {
    return ['', null].includes(value(current.field, 'AXValue')) &&
        value(current.field, 'AXNumberOfCharacters') === 0 &&
        children(current.entry).map(el => identifier(el) || value(el, 'AXDescription')).join(',') ===
            'add,messageBodyField,Record audio,Emoji picker';
}

function replyComposer(context, target) {
    const current = composer(context, 'Reply transcript', 'Reply');
    if (!current) return null;
    const focus = attr(context.app, 'AXFocusedUIElement');
    if (!focus || !$.CFEqual(focus, current.field)) return null;
    const matches = targetBalloons(current.view, target);
    if (matches.length !== 1) return null;
    // The thread's first message row must contain the target, not just a later reply.
    const rows = value(current.view, 'AXVisibleChildren') || children(current.view);
    if (!rows.length || role(rows[0]) !== 'AXButton' || value(rows[0], 'AXDescription') !== 'Dismiss replies') return null;
    const root = rows.find(row => children(row).some(el => identifier(el) === 'Sticker'));
    const owner = target.kind ? matches[0] : attr(matches[0], 'AXParent');
    const row = owner && attr(owner, 'AXParent');
    return root && row && $.CFEqual(root, row) ? current : null;
}

function keyEvents(code) {
    const down = $.CGEventCreateKeyboardEvent(null, code, true);
    const up = $.CGEventCreateKeyboardEvent(null, code, false);
    $.CGEventSetFlags(down, 0);
    $.CGEventSetFlags(up, 0);
    return [down, up];
}

function postKey(pid, events) {
    for (const event of events) $.CGEventPostToPid(pid, event);
}

function prepareReply(context) {
    // Reply panes can stay open when the same conversation is opened again.
    const open = composer(context, 'Reply transcript', 'Reply');
    if (open) {
        const focus = attr(context.app, 'AXFocusedUIElement');
        if (!emptyComposer(open) || !focus || !$.CFEqual(focus, open.field)) {
            throw new Error('Close the existing reply pane in Messages first');
        }
        postKey(context.pid, keyEvents(53)); // Escape closes the empty reply pane.
    }
    const normal = waitFor(() => composer(context, 'Messages', 'iMessage'), 2);
    if (!normal || !emptyComposer(normal)) throw new Error('Cannot verify an empty iMessage composer before opening the thread');
}

function reply(args) {
    const dryRun = args[0] === '--dry-run';
    if (dryRun) args.shift();
    const [chat, guid, text] = args;
    if (args.length !== 3 || !/^[1-9][0-9]{0,18}$/.test(chat) || (chat.length === 19 && chat > '9223372036854775807') ||
        !guid || !text.trim() || /[\x00\ufffc]/.test(text)) {
        throw new Error('Usage: bubbleterm-reply [--dry-run] CHAT_ID MESSAGE_GUID TEXT');
    }
    const origin = sqlQuote(guid);
    const target = resolveTarget(chat, origin);
    if (target.service !== 'iMessage' || target.chatService !== 'iMessage') throw new Error('Only iMessage threads are supported');
    if (target.origin || target.parts !== target.part + 1) throw new Error('Cannot isolate a replyable thread origin');
    const part = `${target.part}:${target.part}:${target.kind ? 1 : target.text.length}`;

    ObjC.import('Quartz');
    ObjC.bindFunction('CGPreflightPostEventAccess', ['bool', []]);
    ObjC.bindFunction('AXUIElementIsAttributeSettable', ['int', ['id', 'id', 'bool*']]);
    ObjC.bindFunction('AXUIElementSetAttributeValue', ['int', ['id', 'id', 'id']]);
    if (!$.CGPreflightPostEventAccess()) throw new Error('The helper cannot post a key to Messages');

    const context = withTargetMenu(target, 'reply…', dryRun ? '--check' : null, (item, context) => {
        const normal = composer(context, 'Messages', 'iMessage');
        if (!normal || !emptyComposer(normal)) throw new Error('Cannot verify an empty iMessage composer before opening the thread');
        if (value(item, 'AXTitle') !== 'Reply…') throw new Error('Cannot verify the Reply menu item');
        const status = $.AXUIElementPerformAction(item, 'AXPress');
        if (status !== 0) throw new Error('Cannot choose Reply (AX error ' + status + ')');
        return context;
    }, prepareReply);
    const probe = () => replyComposer(context, target);
    const current = waitFor(probe, 3);
    if (!current || !emptyComposer(current)) throw new Error('Cannot verify an empty composer for the exact reply thread');
    const settable = Ref();
    if ($.AXUIElementIsAttributeSettable(current.field, 'AXValue', settable) !== 0 || !settable[0]) {
        throw new Error('Cannot set text in the reply composer');
    }
    if (dryRun) return 'Reply menu and exact thread composer verified. No text entered or sent.';

    const after = query('SELECT CAST(COALESCE(max(ROWID), 0) AS TEXT) AS id FROM message')[0].id;
    const submit = keyEvents(36);
    const empty = probe();
    if (!empty || !$.CFEqual(empty.field, current.field) || !emptyComposer(empty)) {
        throw new Error('The reply composer changed before text entry');
    }
    // Write only to the verified field. Do not use the keyboard or pasteboard for text.
    const entered = $.AXUIElementSetAttributeValue(current.field, 'AXValue', $(text));
    if (entered !== 0) throw new Error('Cannot set reply text (AX error ' + entered + '). Check Messages for an unsent draft');
    const ready = probe();
    const focus = attr(context.app, 'AXFocusedUIElement');
    if (!ready || !$.CFEqual(ready.field, current.field) || value(ready.field, 'AXValue') !== text ||
        value(ready.view, 'AXDescription') !== 'Reply transcript' || !focus || !$.CFEqual(focus, ready.field)) {
        throw new Error('Reply composer or text changed. Check Messages for an unsent draft');
    }
    // Messages sends on Return. Post once to its PID, never to the global event stream.
    try {
        postKey(context.pid, submit);
        const needle = sqlQuote(text);
        const recorded = waitFor(() => {
            const rows = query(`
                SELECT m.guid, m.service, m.text, hex(m.attributedBody) AS body,
                       m.thread_originator_guid AS origin, m.thread_originator_part AS part,
                       m.is_sent AS sent, m.is_finished AS finished, m.error
                FROM message m JOIN chat_message_join j ON j.message_id = m.ROWID
                WHERE m.ROWID > ${after} AND j.chat_id = ${chat} AND m.is_from_me = 1
                  AND COALESCE(m.associated_message_type, 0) = 0
                  AND (m.thread_originator_guid COLLATE BINARY = ${origin} OR m.text COLLATE BINARY = ${needle}
                    OR instr(m.attributedBody, CAST(${needle} AS BLOB)) > 0)`)
                .filter(row => row.origin === guid || messageText(row) === text);
            if (rows.length > 1) throw new Error('More than one outgoing message matches the reply');
            const [row] = rows;
            if (!row) return null;
            if (row.error) throw new Error('Messages reported a send error');
            if (!row.sent || !row.finished) return null;
            if (row.service !== 'iMessage' || row.origin !== guid || row.part !== part || messageText(row) !== text) {
                throw new Error('The outgoing message did not match the exact iMessage thread and text');
            }
            return row.guid;
        }, 10);
        if (!recorded) throw new Error('No matching sent iMessage reply was recorded');
        return recorded;
    } catch (error) {
        throw new Error(error.message + '. Check Messages before retrying');
    }
}

function run(args) {
    return args.shift() === 'bubbleterm-reply' ? reply(args) : react(args);
}
